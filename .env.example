# Port server API lokal (default 4000)
PORT=4000

# WAJIB diganti di produksi: rahasia penandatanganan JWT
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d

# Database Turso (libSQL).
# Lokal: file:./data/roamplan.db  |  Produksi: libsql://nama-db-anda.turso.io
TURSO_DATABASE_URL=file:./data/roamplan.db
# Token Turso (kosongkan untuk file lokal)
TURSO_AUTH_TOKEN=

# Origin frontend yang diizinkan (pisahkan dengan koma), mis. https://roamplan.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Tarif estimasi transportasi per kilometer (Rupiah)
TRANSPORT_RATE_PER_KM=2500
