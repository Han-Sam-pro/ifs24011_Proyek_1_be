# Port server saat dijalankan lokal (default 3001). Tidak dipakai di Vercel.
PORT=3001

# === Database ===
# Produksi (Vercel + Turso): isi kedua variabel ini dari dashboard Turso.
# TURSO_DATABASE_URL=libsql://<nama-database>-<organisasi>.turso.io
# TURSO_AUTH_TOKEN=<token-dari-turso>

# Lokal / test: jika TURSO_DATABASE_URL dikosongkan, dipakai file SQLite lokal.
# SQLITE_PATH=./data/roamplan.db

# Origin frontend yang diizinkan (dipisah koma), mis. URL Netlify atau Vercel frontend
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
