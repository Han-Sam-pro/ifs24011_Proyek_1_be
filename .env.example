# Port server API (default 4000; frontend Vite memproxy /api ke sini)
PORT=4000

# WAJIB diganti di produksi: rahasia penandatanganan JWT
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d

# Lokasi berkas database SQLite
DB_PATH=./data/roamplan.db

# Origin frontend yang diizinkan (pisahkan dengan koma). Tidak perlu bila frontend memakai proxy /api
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Tarif estimasi transportasi per kilometer (Rupiah), dipakai untuk menghitung biaya jarak antar destinasi
TRANSPORT_RATE_PER_KM=2500
